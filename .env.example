# OpenAI (optional when enrichment.mode is fallback or disabled)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Canvas personal access token flow
CANVAS_BASE_URL=https://school.instructure.com
CANVAS_ACCESS_TOKEN=

# Google OAuth Desktop client. Prefer GOOGLE_CLIENT_SECRET_FILE over inline values.
GOOGLE_CLIENT_SECRET_FILE=./secrets/google-oauth-client.json
GOOGLE_TOKEN_FILE=./secrets/google-oauth-token.json

# Todoist personal API token
TODOIST_API_TOKEN=

# Optional overrides
TASK_SYNC_CONFIG=./task-sync.config.json
TASK_SYNC_DB=./data/task-sync.sqlite
